# Run python3 backend/scripts/setup-local-db.py to prepare .env.local (no DB access).
# Reference only: the script generates a separate 64-character hexadecimal password.
CRM_LOCAL=1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cadbimoz_backend_dev
DB_USER=cadbimoz_backend_dev
DB_PASSWORD=
NODE_ENV=development
PORT=3002
CORS_ALLOWED_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:5500,http://127.0.0.1:5500
